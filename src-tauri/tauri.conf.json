{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cube Utility Client",
  "version": "../package.json",
  "identifier": "dev.cubeutility.client",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cube Utility Client",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#0A1112"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://textures.minecraft.net https://cdn.modrinth.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Cube Utility",
    "shortDescription": "Launcher for the Cube Utility CubeCraft modpack",
    "licenseFile": "installer-notice.txt",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMDg4MDEzMjBBODA4NEYKUldSUENLZ2dFNEFJYTF3REVYQkZCMTg5cGNWV2NrNW4vYkw0bE4yWTNXL2dLYXVaaWhZTnNPQzgK",
      "endpoints": ["https://github.com/SisuKah/cube-utility-client/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
