{
  "name": "cube-utility-client",
  "productName": "Cube Utility Client",
  "version": "1.0.0",
  "description": "Auto-updating launcher for the Cube Utility CubeCraft modpack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/build.mjs",
    "release:launcher": "node scripts/release-launcher.mjs",
    "keys:updater": "node scripts/updater-keys.mjs",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "pack:build": "cargo run --quiet -p pack -- build",
    "pack:add": "cargo run --quiet -p pack -- add",
    "pack:serve": "cargo run --quiet -p pack -- serve",
    "pack:rollback": "cargo run --quiet -p pack -- rollback",
    "keys:generate": "cargo run --quiet -p pack -- keys"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
